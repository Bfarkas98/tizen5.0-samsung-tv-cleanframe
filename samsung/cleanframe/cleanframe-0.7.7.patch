+/* Local city preference and a bounded Open-Meteo forecast request. */
+(function () {
+  'use strict';
+  var LOCATION_KEY = 'cleanframe.weather.location.v1';
+  var FORECAST_KEY = 'cleanframe.weather.forecast.v1';
+  var DEFAULT = { name: 'Budapest', country: 'Hungary', latitude: 47.4979, longitude: 19.0402 };
+  var FORECAST = 'https://api.open-meteo.com/v1/forecast';
+  var SEARCH = 'https://geocoding-api.open-meteo.com/v1/search';
+  var UPDATE_MS = 15 * 60 * 1000;
+  var MAX_CACHE_MS = 6 * 60 * 60 * 1000;
+  var location = read(LOCATION_KEY);
+  if (!validLocation(location)) location = DEFAULT;
+  var cached = read(FORECAST_KEY);
+  var nextRequest = 0;
+  var requestInProgress = null;
+  var unavailable = false;
+
+  function read(key) {
+    try { return JSON.parse(localStorage.getItem(key)); } catch (error) { return null; }
+  }
+  function validNumber(value) { return typeof value === 'number' && isFinite(value); }
+  function validLocation(value) {
+    return value && typeof value.name === 'string' && value.name.trim() &&
+      validNumber(value.latitude) && Math.abs(value.latitude) <= 90 &&
+      validNumber(value.longitude) && Math.abs(value.longitude) <= 180;
+  }
+  function coordinateKey(value) { return value.latitude + ',' + value.longitude; }
+  function validCache(entry, age) {
+    var forecast = entry && entry.forecast;
+    return entry && entry.key === coordinateKey(location) && age >= 0 && age < MAX_CACHE_MS &&
+      forecast && validNumber(forecast.temperature) && typeof forecast.condition === 'string' &&
+      Array.isArray(forecast.days) && forecast.days.length <= 3 && forecast.days.every(function (day) {
+        return day && typeof day.date === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(day.date) &&
+          validNumber(day.high) && validNumber(day.low) && typeof day.condition === 'string';
+      });
+  }
