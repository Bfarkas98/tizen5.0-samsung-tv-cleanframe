+    var xhr = new window.XMLHttpRequest();
+    xhr.open('GET', url, true);
+    xhr.timeout = 8000;
+    xhr.onload = function () {
+      var data;
+      try { data = JSON.parse(xhr.responseText); } catch (error) { done(null); return; }
+      done(xhr.status >= 200 && xhr.status < 300 ? data : null);
+    };
